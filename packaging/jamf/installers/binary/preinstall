#!/bin/zsh
set -eu

[[ "${3:-/}" == "/" ]] || { echo "VGS ShellFirm requires the boot volume." >&2; exit 1; }

readonly managed_binary="/Library/Application Support/VGS/ShellFirm/bin/shellfirm"
readonly command_path="/usr/local/bin/shellfirm"
readonly managed_checks='/Library/Application Support/VGS/ShellFirm/checks/default-checks.yaml'
[[ -f "$managed_checks" && ! -L "$managed_checks" ]] || {
  echo 'Install the VGS ShellFirm Checks package before the managed-checks binary.' >&2; exit 1;
}
[[ "$(/usr/bin/shasum -a 256 "$managed_checks" | /usr/bin/awk '{print $1}')" == '@CHECKS_SHA256@' ]] || {
  echo 'Default checks do not match this approved binary installation.' >&2; exit 1;
}

arm64_available=$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null) || arm64_available="0"

if [[ "${arm64_available}" != "1" ]]; then
  /bin/echo "VGS ShellFirm installation stopped: Apple Silicon (arm64) is required." >&2
  exit 1
fi

# The shell hooks generated by ShellFirm call `shellfirm` by command name. Fail
# safely instead of replacing an unrelated executable that already owns the
# managed command path.
if [[ -e "${command_path}" || -L "${command_path}" ]]; then
  if [[ ! -L "${command_path}" ]]; then
    /bin/echo "VGS ShellFirm installation stopped: ${command_path} exists and is not a symbolic link." >&2
    exit 1
  fi

  existing_target="$(/usr/bin/readlink "${command_path}")"
  if [[ "${existing_target}" != "${managed_binary}" ]]; then
    /bin/echo "VGS ShellFirm installation stopped: ${command_path} points to an unmanaged target." >&2
    exit 1
  fi
fi

exit 0
